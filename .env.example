# Copie este arquivo para .env e preencha com os dados do seu projeto.
# Painel do Supabase > Project Settings > API
#
# O .env está no .gitignore e não vai para o repositório. Mas ATENÇÃO: a chave
# anônima é embutida no bundle do site, do .exe e do APK — ela é pública por
# natureza. Quem proteje os dados é a política de RLS no banco, não o segredo
# da chave. Leia a seção de segurança do README.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
